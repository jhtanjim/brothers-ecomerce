# Copy to .env.local. Never commit .env.local

# Where the NestJS API runs (used server-side and by the /api/v1 rewrite)
BACKEND_URL=http://localhost:4000

# Which store this deployment is: geton, iliyan or shatkania (see lib/store.ts). Fixed at build time.
NEXT_PUBLIC_STORE_ID=geton

# Public site URL (used later for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
