# ---------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# NEVER commit .env
# ---------------------------------------------------------------

# --- Database (existing local PostgreSQL, managed with pgAdmin) ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# If the password contains special characters (@ : / ? # %) URL-encode them, e.g. @ -> %40
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Used only by the automated test suite (separate database, same server).
# The database name MUST end with _test.
DATABASE_URL_TEST="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME_test?schema=public"

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Auth (required from Phase 3) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Storage / payments (filled in later phases) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BKASH_NUMBER=
NAGAD_NUMBER=
