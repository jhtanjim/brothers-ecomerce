{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce platform: Next.js storefront/admin + NestJS API + PostgreSQL (Prisma)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "npm run db:check -w backend",
    "db:migrate": "npm run prisma:migrate -w backend --",
    "db:deploy": "npm run prisma:deploy -w backend",
    "db:validate": "npm run prisma:validate -w backend",
    "db:generate": "npm run prisma:generate -w backend",
    "db:studio": "npm run prisma:studio -w backend"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
